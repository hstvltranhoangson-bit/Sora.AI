{
  "name": "sora",
  "version": "1.0.0",
  "description": "Sora desktop companion: original RT Electron animation with the Python Sora backend, Ollama and SQLite.",
  "author": "Sora integration (original RT source by mochiiwuff)",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test:sora": "node --test tests/sora-backend.test.js tests/sora-integration.test.js tests/vietnamese.test.js tests/perches.test.js tests/offline-chat.test.js tests/menu-interaction.test.js tests/sora-interactions.test.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "sora.desktop",
    "productName": "Sora",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "backend/**",
      "!backend/.venv/**",
      "!backend/**/__pycache__/**",
      "!backend/**/*.pyc",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "backend/**",
      "hooks/**",
      "src/main/windows.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/sora.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sora",
      "artifactName": "Sora-Setup.${ext}"
    }
  }
}
